             <property name="styleSheet">
              <string notr="true">/* 1. El texto y el margen que ya tenías */
QCheckBox {
    font: 13pt &quot;Century Gothic&quot;;
    font-weight: bold;
    color: rgb(222, 223, 225);
    background-color: transparent;
    margin-right: 8px;
}

/* 2. El recuadro vacío (apagado) */
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 2px solid #393F44; /* El gris de tus bordes */
    border-radius: 3px;
    background-color: #22262a; /* El color de tu powerBar */
}

/* 3. El recuadro cuando pasas el mouse por encima (hover) */
QCheckBox::indicator:hover {
    border: 2px solid #00FA9A; /* Se ilumina en verde menta */
}

/* 4. El recuadro cuando está activado (tildado) */
QCheckBox::indicator:checked {
    background-color: #00FA9A; /* Se llena de verde menta */
    border: 2px solid #00FA9A;
}</string>
